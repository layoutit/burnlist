<loop id="branch" version="0.1.0" entry="plan">
  <budget max-rounds="7" max-minutes="90" max-agent-runs="12" max-check-runs="5" max-transitions="24" max-output-bytes="262144"/>
  <agent id="plan" mode="task" execution="host" intelligence="strong" role="maker" route="implementation.standard" authority="write" instructions="plan"/>
  <agent id="branches" mode="task" execution="host" intelligence="fast" role="maker" route="implementation.fast" authority="write" instructions="branches"/>
  <agent id="merge" mode="task" execution="host" intelligence="standard" role="maker" route="implementation.standard" authority="write" instructions="merge"/>
  <check id="validate" capability="repo-verify"/>
  <agent id="review" mode="review" execution="host" intelligence="strong" role="reviewer" route="review.strong" authority="read" independent-from="merge" requires="fresh-session:enforced,filesystem-write-deny:supervised" instructions="review"/>
  <gate id="converged" kind="convergence" requires="validate,review"/>
  <terminal id="completed" state="converged"/>
  <terminal id="needs-human" state="needs-human"/>
  <terminal id="failed" state="failed"/>
  <terminal id="stopped" state="stopped"/>
  <terminal id="exhausted" state="budget-exhausted"/>
  <failure-policy error="failed" timeout="failed" cancelled="stopped" lost="needs-human" exhausted="exhausted"/>
  <edge from="plan" on="complete" to="branches"/>
  <edge from="branches" on="complete" to="merge"/>
  <edge from="merge" on="complete" to="validate"/>
  <edge from="validate" on="pass" to="review"/>
  <edge from="validate" on="fail" to="branches" max-visits="3"/>
  <edge from="review" on="approve" to="converged"/>
  <edge from="review" on="reject" to="plan" max-visits="3"/>
  <edge from="review" on="escalate" to="needs-human"/>
  <edge from="converged" on="pass" to="completed"/>
  <edge from="converged" on="fail" to="needs-human"/>
</loop>
